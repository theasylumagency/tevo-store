{
  "name": "tevo-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "media:link": "node scripts/link-media.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:mocks": "node scripts/mock-providers.mjs",
    "test:frontend": "node --import tsx --test tests/*.test.ts",
    "test:catalog": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "test:catalog-ui": "node scripts/test-catalog-ui.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@fontsource-variable/noto-sans-georgian": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "smtp-server": "^3.21.7",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

# What this deployment IS (not secret, versioned). Baked into the image at build time — prerendered pages
# depend on it — so change it here and push; GitHub Actions rebuilds and redeploys.
STORE_ID=rodo
PUBLIC_BASE_URL=https://rodo.ge
# 1 = review build: Lika's notes visible, site hidden from search engines. 0 = public launch.
REVIEW_MODE=1

# rodo.ge on a server that already runs nginx (e.g. next to Khidi).
# Start with this plain-HTTP block; certbot then adds HTTPS and the http→https redirect itself:
#   sudo certbot --nginx -d rodo.ge -d www.rodo.ge --redirect
# 3000 = APP_PORT in /srv/rodo/.env.production (bootstrap.sh may have picked 3001… if 3000 was taken).
server {
    listen 80;
    server_name rodo.ge www.rodo.ge;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;           # used by the admin login rate limit
        proxy_set_header X-Forwarded-For $remote_addr;     # overwrite, don't append client-supplied hops
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}

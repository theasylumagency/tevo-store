{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tevo.ge/schema/catalog/1.0.0",
  "title": "Store catalog v1 — data contract between Khidi (or a file standing in for it) and the storefronts",
  "type": "object",
  "required": ["schema_version", "generated_at", "source", "categories", "product_types", "brands", "products"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.\\d+\\.\\d+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["legacy_woocommerce_export", "khidi_api"]}}},
    "stats": {"type": "object"},
    "categories": {"type": "array", "items": {"type": "object", "required": ["id", "name", "position", "product_types"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "position": {"type": "integer"},
                     "product_types": {"type": "array", "items": {"type": "string"}}}}},
    "product_types": {"type": "array", "items": {"type": "object", "required": ["id", "name", "category", "facets"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "name_plural": {"type": "string"},
                     "category": {"type": "string"}, "facets": {"type": "array", "items": {"type": "string"}}}}},
    "brands": {"type": "array", "items": {"type": "object", "required": ["id", "name"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "name_ka": {"type": "string"}, "slug": {"type": "string"}}}},
    "attribute_vocabulary": {"type": "object"},
    "spec_vocabulary": {"type": "array"},
    "quality_issue_labels": {"type": "object"},
    "products": {"type": "array", "items": {"$ref": "#/$defs/product"}}
  },
  "$defs": {
    "product": {
      "type": "object",
      "required": ["id", "slug", "name", "product_type", "category", "price", "availability", "visible", "attributes",
                   "specs", "features", "description", "relations", "media", "codes", "data_quality"],
      "properties": {
        "id": {"type": "string", "pattern": "^at-\\d+$", "description": "stable id; Khidi will keep a mapping"},
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "legacy_wp_id": {"type": ["integer", "null"]},
        "name": {"type": "string", "minLength": 2},
        "subtitle": {"type": ["string", "null"], "description": "2-4 key specs for product cards"},
        "name_legacy": {"type": ["string", "null"]},
        "product_type": {"type": "string"},
        "category": {"type": "string"},
        "brand": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "variant_group": {"type": ["string", "null"]},
        "price": {"type": "object", "required": ["currency", "base"],
          "properties": {"currency": {"const": "GEL"}, "base": {"type": ["number", "null"], "exclusiveMinimum": 0},
                         "promo": {"type": ["number", "null"]}},
          "description": "base = price floor set in Khidi; promo is managed only in Khidi"},
        "availability": {"type": "object", "required": ["status"],
          "properties": {"status": {"enum": ["in_stock", "low_stock", "out_of_stock", "confirm_with_store"]}}},
        "visible": {"type": "boolean"},
        "attributes": {"type": "object", "description": "normalised, filterable values (see attribute_vocabulary)"},
        "specs": {"type": "array", "items": {"type": "object", "required": ["key", "label", "value"],
          "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "value": {"type": "string"},
                         "num": {"type": "number"}, "num_max": {"type": "number"}, "unit": {"type": "string"},
                         "source": {"type": "string"}}}},
        "features": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string", "description": "plain text; paragraphs split by blank lines, '- ' list items"},
        "compatibility": {"type": ["object", "null"]},
        "relations": {"type": "array", "items": {"type": "object", "required": ["type", "product_id"],
          "properties": {"type": {"enum": ["spare_part", "accessory", "consumable", "fits", "variant", "same_size"]},
                         "product_id": {"type": "string"}, "reason": {"type": "string"}}}},
        "media": {"type": "array", "items": {"type": "object", "required": ["file", "role", "position"],
          "properties": {"asset_key": {"type": "string"}, "file": {"type": "string"}, "source_url": {"type": "string"},
                         "width": {"type": "integer"}, "height": {"type": "integer"},
                         "quality": {"enum": ["ok", "review"]}, "role": {"enum": ["main", "gallery"]},
                         "position": {"type": "integer"}, "status": {"type": "string"}}}},
        "videos": {"type": "array", "items": {"type": "string"}},
        "codes": {"type": "object", "properties": {"ean": {"type": "string"}, "supplier": {"type": "string"},
                                                  "legacy_internal": {"type": "string"}}},
        "data_quality": {"type": "object", "required": ["score", "issues"],
          "properties": {"score": {"type": "integer", "minimum": 0, "maximum": 100},
                         "issues": {"type": "array", "items": {"type": "string"}}}}
      }
    }
  }
}

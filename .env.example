# Which storefront this deployment is (one core, several storefronts)
STORE_ID=standard

# Catalog source: "file" today, "khidi" once the Khidi API is ready
CATALOG_SOURCE=file
CATALOG_PATH=data/catalog.json
# KHIDI_API_URL=https://app.khidi.app/api/catalog
# KHIDI_API_TOKEN=

# Folder that holds the legacy media ("originals/..."); linked into public/media
MEDIA_DIR=../AgroTrade_Legacy_Media

# 1 = show data-quality panels and the legacy name (for catalog review, never in production)
REVIEW_MODE=1

# Database: postgres://user:pass@host:5432/rodo in production; pglite (embedded) for local dev
DATABASE_URL=pglite:./.data/db

# Payments:
#   off  = card/installment hidden, customers order with "pay on delivery" (default in production)
#   test = built-in mock bank (production only with ALLOW_TEST_PAYMENTS=1, e.g. a password-protected staging)
#   live = real banks; only methods whose credentials below are set are shown
PAYMENTS_MODE=test
# ALLOW_TEST_PAYMENTS=1
# BOG_CLIENT_ID_STANDARD=
# BOG_CLIENT_SECRET_STANDARD=
# TBC_API_KEY_STANDARD=
# TBC_CLIENT_ID_STANDARD=
# TBC_CLIENT_SECRET_STANDARD=

# Public base URL (used for bank callbacks / return URLs)
PUBLIC_BASE_URL=http://localhost:3000

# Store admin (orders, catalog publication and settings)
# Optional editor password grants only catalog draft/preview access.
# CATALOG_EDITOR_PASSWORD=
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Token Khidi uses to pull new orders from /api/outbox/orders
OUTBOX_TOKEN=

# --- Notifications ---------------------------------------------------------
# SMS: smsoffice.ge is used as soon as SMSOFFICE_API_KEY + SMS_SENDER are set; without a key SMS are off
# (production) or only logged (development). SMS_PROVIDER=console | off forces either.
SMS_PROVIDER=console
# SMSOFFICE_API_KEY=
# SMS_SENDER=          # sender name registered at smsoffice.ge
# georgian (UCS-2, 70 chars/segment) | latin (transliterated, 160 chars/segment, cheaper)
SMS_ALPHABET=georgian

# E-mail: SMTP as soon as SMTP_USER + SMTP_PASS are set (Purelymail: smtp.purelymail.com:465, full address + password).
# EMAIL_TRANSPORT=console | off forces either.
EMAIL_TRANSPORT=console
# SMTP_HOST=smtp.purelymail.com
# SMTP_PORT=465
# SMTP_USER=orders@rodo.ge
# SMTP_PASS=
# EMAIL_FROM="Rodo <orders@rodo.ge>"
# EMAIL_REPLY_TO=info@rodo.ge

# Staff e-mails for new orders are set in the admin (/admin/settings); this is only the initial value
STAFF_EMAILS=

# Telegram bot for staff notifications (@BotFather). Chats are connected from /admin/settings.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=      # random, min. 16 chars
# TELEGRAM_API_BASE=            # tests only (mock server)

# Token for the retry runner: POST /api/cron/notifications (call every minute from cron)
CRON_TOKEN=
